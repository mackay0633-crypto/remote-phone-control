# remote-phone-control —— nginx 反向代理示例
#
# 作用三件事：
#   1. 托管前端静态文件（web/dist）
#   2. 把 /api/ 反代到 relay 的 HTTP 接口
#   3. 把 /ws/  反代到 relay 的 WebSocket（Agent 接入 / 浏览器控制 / 视频流）
#
# 这样做的好处：浏览器和 Agent 都只走 443（HTTPS/WSS），
# 5081 可以完全从安全组里关掉，不再对外暴露。
#
# 用法（推荐直接用脚本，它会处理「证书还不存在时 nginx -t 过不了」的先后顺序）：
#   sudo bash deploy/setup-nginx-domain.sh jyglobal.top you@example.com
#
# 手工用法：
#   1. 把下面所有 your-domain.com 换成你的域名（包括证书路径那两行，
#      certbot 的目录名就是 -d 的第一个域名）
#   2. 放到 /etc/nginx/sites-available/remote-phone-control
#   3. ln -s 到 sites-enabled，nginx -t 通过后 reload
#
# ⚠️ 直接启用本文件是**不行的**：它引用了 /etc/letsencrypt/live/... 下的证书，
#    证书没签之前 `nginx -t` 会直接失败。先按脚本的两步走（HTTP-only → 签证书
#    → 换成这份），或者先手工签好证书再启用。

# ── HTTP：ACME 校验 + 跳转 HTTPS ─────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com www.your-domain.com;

    # Let's Encrypt 续期校验需要走明文 80
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS ───────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name your-domain.com www.your-domain.com;

    ssl_certificate     /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 视频上传用得到：默认 1MB 会让所有视频直接 413。
    # 这个值与 relay 的 VIDEO_MAX_BYTES 默认值（512MB）保持一致，
    # 改一边就要改另一边，否则 nginx 先拦或 relay 先拦，报错位置会很迷惑。
    client_max_body_size 512m;

    # ── 前端静态文件 ─────────────────────────────────────────
    # 注意：指向 /var/www，**不是**仓库里的 web/dist。
    #
    # 原因：Ubuntu 家目录是 0750（drwxr-x---），而 nginx 以 www-data 运行，
    # 根本进不去 /home/ubuntu，会直接 403。错误日志里长这样：
    #   stat() "/home/ubuntu/.../web/dist/" failed (13: Permission denied)
    #
    # 产物由 deploy/deploy.sh 发布到这里。
    root /var/www/remote-phone-control;
    index index.html;

    # SPA：找不到的路径一律回 index.html，交给前端路由
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 构建产物带内容哈希，可以放心长缓存
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # index.html 不能缓存，否则前端更新后用户拿到旧页面
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # ── 账号 / 管理 API ──────────────────────────────────────
    location /api/ {
        proxy_pass http://127.0.0.1:5081;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 视频上传是「浏览器 → nginx → relay」的裸字节流。
        # 默认 nginx 会先把整个请求体缓冲到临时文件再转发，
        # 512MB 的视频等于写两遍磁盘。关掉后字节直接透传给 relay 落盘。
        proxy_request_buffering off;
        # 大文件在慢网络下传输可能远超默认 60 秒
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }

    # ── WebSocket ────────────────────────────────────────────
    # 覆盖三个端点：/ws/agent（Agent 接入）、/ws/viewer（控制通道）、
    # /ws/viewer/stream（视频流）
    location /ws/ {
        proxy_pass http://127.0.0.1:5081;
        proxy_http_version 1.1;

        # 这两行是 WebSocket 必须的，缺了会握手失败
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host      $host;
        proxy_set_header X-Real-IP $remote_addr;

        # 视频流是长连接，nginx 默认 60 秒无数据就断开 —— 必须调大
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # 边收边转，不要缓冲，否则画面延迟会越积越多
        proxy_buffering off;
    }

    # ── relay 健康检查（可选，便于外部探活）──────────────────
    location = /health {
        proxy_pass http://127.0.0.1:5081/health;
        proxy_set_header Host $host;
    }
}
