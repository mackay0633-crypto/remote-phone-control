# relay 环境变量模板
#
# 用法：复制成 relay/.env 后按需修改。
#   relay/.env 已被 .gitignore 忽略（第 3 行的 `.env` 会匹配任意层级），
#   请**不要**把真实凭据写进本文件（这个模板是要提交的）。
#
# 优先级：**真实环境变量优先于 .env**（已实测）。
#   所以 `$env:SMTP_PASS=...` 或 pm2 注入的值会压过 .env 里的同名项，
#   「本地用 .env 调试、生产用 pm2 注入」可以共存。
#
# 载入由 relay/src/config/load-env.ts 完成，需要 Node 20.12+。

# ── 邮件发送（上生产必做）──────────────────────────────────────
# console = 验证码只打印在 relay 日志里，不真正发信（开发默认）
# smtp    = 经 nodemailer 真实发信
MAIL_TRANSPORT=console

# 以下仅在 MAIL_TRANSPORT=smtp 时必填；缺任何一项 relay 会拒绝启动
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=you@qq.com
# SMTP_PASS=<授权码，不是邮箱登录密码>
# SMTP_FROM=you@qq.com
# SMTP_SECURE=true

# ── 运行 ───────────────────────────────────────────────────────
# RELAY_HOST=0.0.0.0
# RELAY_PORT=5081
# RELAY_DB_FILE=data/relay.db

# ── Agent 共享密钥（发视频必填）────────────────────────────────
# 客户上传的视频素材由「设备主机上的 agent」下载，这个通道不走用户会话，
# 而是用一把共享密钥认证（素材是客户数据，任何登录用户都不该能下载别人的）。
#
# 生成一次，两处填**完全相同**的值：
#   服务器 relay/.env  ← 这里
#   设备主机          setx AGENT_SECRET "<同一个值>"
# 生成：openssl rand -hex 32
#
# ⚠️ 不配的后果很隐蔽：注册、看画面、操控全都正常，
#    只有「发视频」会失败（agent 下载视频时报 503/401）。
#    未配置时 relay 是 fail closed 的（宁可拒绝也不放行）。
# AGENT_SECRET=<64 位 hex>

# ── 视频素材（发视频相关）──────────────────────────────────────
# RELAY_MEDIA_DIR=data/videos      # 相对 relay/ 解析
# VIDEO_MAX_BYTES=536870912        # 单文件上限 512MB，要与 nginx 的 client_max_body_size 对齐
# AUTOMATION_TIMEOUT_MS=600000     # relay 等 agent 回执的上限 10 分钟

# ── 初始管理员（仅首次启动生效）────────────────────────────────
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=<强密码；不填则随机生成并打印一次>

# NODE_ENV=production
#   生产必须设置：它除了性能开关，还会关掉「验证码随接口回显」（devCode）。
#   不设时 relay 会把验证码放进发码响应里方便前端调试——对外服务时那是取码后门。

# ── 限流与验证码（一般不用改）──────────────────────────────────
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_WINDOW_MINUTES=15
# REGISTER_MAX_ATTEMPTS=10
# REGCODE_MAX_ATTEMPTS=5
# RESET_MAX_ATTEMPTS=10
# VERIFICATION_CODE_TTL_MINUTES=10
# VERIFICATION_RESEND_SECONDS=60
# VERIFICATION_MAX_ATTEMPTS=5
